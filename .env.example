PORT=3000

# --- Clio API ---
CLIO_BASE_URL=https://app.clio.com
CLIO_API_BASE_URL=https://app.clio.com/api/v4
# Same Clio OAuth app the platform uses — needed to REFRESH per-user tokens.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# --- Platform vault (shared Postgres holding per-user, encrypted Clio tokens) ---
# Connect as the NON-superuser role `noe_app` so row-level security is enforced.
# Append ?sslmode=require (or set DATABASE_SSL=true) when the DB requires TLS.
DATABASE_URL=postgresql://noe_app:<password>@<public-proxy-host>:<port>/railway
# 32-byte master key, base64-encoded. MUST be the SAME value as the platform.
APP_KEK_B64=

# --- Microsoft OAuth (per-user identity) ---
MS_TENANT_ID=
MS_CLIENT_ID=
# Only needed if the Microsoft app is a confidential (web) client.
MS_CLIENT_SECRET=
# Audience expected on the Microsoft v2 access token, e.g. api://<client-id>
MCP_AUDIENCE=api://<client-id>
# Required scope name, matched against `scp` (delegated) or `roles` (app)
MCP_SCOPE_NAME=mcp.access
# Onboarding allowlist: exact emails first, then domains. If BOTH are empty,
# every authenticated user is allowed (a warning is logged).
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Externally reachable origin of THIS server (used for OAuth discovery + downloads).
PUBLIC_BASE_URL=https://your-clio-mcp-host

# --- Review UI (optional, unchanged) ---
ANTHROPIC_API_KEY=            # Required for /review AI-generated suggestions
REVIEW_PASSWORD=              # Password for /review UI (leave empty for no auth)

# --- Box (unchanged — out of scope) ---
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=
